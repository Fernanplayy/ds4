@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Operaciones</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            min-height: 100vh;
            background: linear-gradient( 180deg, rgba(235, 255, 235, 1) 55%, rgba(178, 235, 189, 1) 99% );
        }

        /* Barra superior */
        .top-bar {
            background: #268F3A;
            color: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 18px;
        }

        .logout {
            font-size: 14px;
            color: #e0ffe5;
            text-decoration: underline;
        }

            .logout:hover {
                color: white;
            }

        /* Contenedor principal */
        .op-container {
            background: white;
            width: 380px;
            margin: 100px auto;
            padding: 30px;
            border-radius: 6px;
            box-shadow: 0 0 10px rgba(0,0,0,0.15);
            text-align: center;
        }

            .op-container img {
                width: 180px;
                margin-bottom: 20px;
            }

        h2 {
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
        }

        select, input {
            width: 100%;
            padding: 10px;
            margin-top: 8px;
            margin-bottom: 15px;
            font-size: 16px;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #268F3A;
            color: white;
            border: none;
            font-size: 18px;
            cursor: pointer;
            border-radius: 4px;
        }

            button:hover {
                opacity: 0.9;
            }

        .error {
            color: red;
            margin-top: 15px;
        }

        .success {
            color: green;
            margin-top: 15px;
        }

        .back-link {
            display: block;
            margin-top: 20px;
            color: #268F3A;
            text-decoration: none;
        }

            .back-link:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>

    <div class="top-bar">
        <span>@Session["Nombre"]</span>
        <a href="/Banco/Logout" class="logout">Cerrar sesión</a>
    </div>

    <div class="op-container">
        <img src="https://i.imgur.com/uWaRvnR.png" />

        <h2>Depósito / Retiro</h2>

        <form method="post">
            <label>Tipo de operación</label>
            <select name="tipo" required>
                <option value="DEPOSITO">Depósito</option>
                <option value="RETIRO">Retiro</option>
            </select>

            <label>Monto</label>
            <input type="number" name="monto" step="0.01" required />

            <button type="submit">Aceptar</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        @if (ViewBag.Mensaje != null)
        {
            <div class="success">@ViewBag.Mensaje</div>
        }

        <a href="/Banco/Cuenta" class="back-link">Volver a Ver Cuenta</a>
    </div>

</body>
</html>