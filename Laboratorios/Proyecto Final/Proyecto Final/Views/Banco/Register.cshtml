@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Registro</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            min-height: 50vh;
            background: linear-gradient( 180deg, rgba(235, 255, 235, 1) 55%, rgba(178, 235, 189, 1) 99% );
        }

        .top-bar {
            background: #268F3A;
            color: white;
            padding: 15px 30px;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
        }

        .register-container {
            background: white;
            width: 380px;
            margin: 100px auto;
            padding: 30px;
            border-radius: 6px;
            box-shadow: 0 0 10px rgba(0,0,0,0.15);
            text-align: center;
        }

        .register-container img {
            width: 200px;
            margin-bottom: 20px;
        }

        input {
            width: 100%;
            padding: 10px;
            margin-top: 10px;
            font-size: 16px;
        }

        button {
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            background: #268F3A;
            color: white;
            border: none;
            font-size: 18px;
            cursor: pointer;
            border-radius: 4px;
        }

            button:hover {
                opacity: 0.9;
            }

        .error {
            color: red;
            margin-top: 15px;
        }

        .login-link {
            display: block;
            margin-top: 20px;
            color: #268F3A;
            text-decoration: none;
        }

            .login-link:hover {
                text-decoration: underline;
            }
    </style>
</head>

<body>

    <div class="top-bar">
        Fleeca Bank
    </div>

    <div class="register-container">
        <img src="https://i.imgur.com/uWaRvnR.png" />

        <h2>Crear cuenta</h2>

        <form method="post">
            <input type="text" name="nombre" placeholder="Nombre completo" required />
            <input type="email" name="email" placeholder="Email" required />
            <input type="password" name="password" placeholder="Contraseña" required />

            <button type="submit">Registrar</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <a href="/Banco/Login" class="login-link">Volver al login</a>
    </div>

</body>
</html>
