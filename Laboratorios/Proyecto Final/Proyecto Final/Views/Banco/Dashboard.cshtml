    @{
        Layout = null;
    }

    <!DOCTYPE html>
    <html>
    <head>
        <title>Dashboard</title>

        <style>
            body {
                margin: 0;
                font-family: Arial;
                min-height: 100vh; /* Ocupa toda la pantalla */
                background: linear-gradient( 180deg, rgba(235, 255, 235, 1) 55%, rgba(178, 235, 189, 1) 99% );
            }

            .top-bar {
                background: #268F3A;
                color: white;
                padding: 15px 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 18px;
            }

            .user-info {
                display: flex;
                flex-direction: column; /* Nombre arriba, logout abajo */
            }

            .logout {
                font-size: 14px;
                color: #e0ffe5;
                text-decoration: underline;
                cursor: pointer;
            }

                .logout:hover {
                    color: white;
                }

            .main-container {
                text-align: center;
                margin-top: 80px;
            }

            .bank-btn {
                width: 300px;
                padding: 18px;
                margin: 15px auto;
                font-size: 20px;
                display: block;
                color: white;
                text-decoration: none;
                border-radius: 4px;
            }

            .Transanccionar,
            .deposit,
            .log {
                background: #268F3A;
            }
        </style>
    </head>
    <body>
        <div class="top-bar">
            <div class="user-info">
                <span>@Session["Nombre"]</span>
                <a href="/Banco/Logout" class="logout">Cerrar sesión</a>
            </div>

            <span>Balance: $@ViewBag.Saldo</span>
        </div>
        <div class="main-container">
            <img src="https://i.imgur.com/uWaRvnR.png" width="300" height="100">
            <h2>Choose a service.</h2>

            <a href="/Banco/Transferir" class="bank-btn Transanccionar">Transanccionar</a>
            <a href="/Banco/Operaciones?tipo=DEPOSITO" class="bank-btn deposit">Deposito/Retiro</a>
            <a href="/Banco/Cuenta" class="bank-btn log">Ver cuenta</a>
        </div>
    </body>
    </html>